# ====================================================================
# AI ATS Platform — Environment Configuration Template
# ====================================================================
# Copy this file to .env and configure installation-specific secrets.
# NEVER commit the real .env file or production credentials to Git.
# ====================================================================

# Database Persistence
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ai_ats_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# JWT Cryptographic Signing Secret (64+ character hexadecimal or strong secret)
JWT_SECRET=your_secure_random_64_character_jwt_secret_here_do_not_share

# Single-Administrator Initial Provisioning
# Leave ADMIN_INITIAL_PASSWORD blank if provisioning via /api/auth/admin/bootstrap API
ADMIN_EMAIL=admin@your-domain.internal
ADMIN_INITIAL_PASSWORD=
ADMIN_BOOTSTRAP_TOKEN=your_secure_installation_bootstrap_token_here

# Mail Service (Optional for Password Reset Verification Codes)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080/api
