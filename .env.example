# AI ATS Backend Environment Variables Configuration Template
# Duplicate this file to .env or configure in system environment

# Server
SERVER_PORT=8080

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/ai_ats_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Spring Security & JWT Configuration
# Minimum 256-bit secure hex key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Mail Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=no-reply@ai-ats.internal

# CORS Allowed Origin
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Storage Path for Resume Documents
FILE_STORAGE_PATH=./uploads/resumes
