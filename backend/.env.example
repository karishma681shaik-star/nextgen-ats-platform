# ====================================================================
# Backend Server Environment Variables
# ====================================================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ai_ats_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

JWT_SECRET=your_secure_random_64_character_jwt_secret_here_do_not_share
JWT_EXPIRATION_MS=86400000

# Single-Administrator Provisioning
ADMIN_EMAIL=admin@your-domain.internal
ADMIN_INITIAL_PASSWORD=
ADMIN_BOOTSTRAP_TOKEN=your_secure_installation_bootstrap_token_here

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGIN=http://localhost:5173
